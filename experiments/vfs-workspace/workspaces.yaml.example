# Copy to service/workspaces.yaml and edit for your setup.
# Auth: X-User-Id header only for Phase 0 (no OIDC).
users:
  chris:
    s3_bucket: mirage-test-chris
    s3_region: ap-southeast-1
    s3_prefix: workspaces/chris
    runtime: docker-local
    mount_name: disk

runtimes:
  docker-local:
    image: mirage-runtime:latest
    aws_env_forwarding: true
  code-interpreter:
    region: us-east-1
    code_interpreter_identifier: aws.codeinterpreter.v1
    session_timeout_seconds: 900
