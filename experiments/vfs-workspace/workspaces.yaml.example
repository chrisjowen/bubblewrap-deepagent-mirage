# Copy to service/workspaces.yaml and edit for your setup.
# Auth: X-User-Id header only for Phase 0 (no OIDC).
#
# Layout:
#   users:      auth membership (X-User-Id must match a key)
#   workspaces: selectable workspaces in the UI (owner + storage + runtime)
#   runtimes:   config blocks for each registered runtime adapter

users:
  chris:
    label: Chris

workspaces:
  docs-docker:
    owner: chris
    label: "Docs (docker)"
    runtime: docker-local
    mount_name: docs
    storage:
      bucket: mirage-test-chris
      region: ap-southeast-1
      prefix: workspaces/chris/docs

  docs-ci:
    owner: chris
    label: "Docs (AgentCore CI)"
    runtime: code-interpreter
    mount_name: docs
    storage:
      bucket: mirage-test-chris
      region: ap-southeast-1
      prefix: workspaces/chris/docs

  code-docker:
    owner: chris
    label: "Code (docker)"
    runtime: docker-local
    mount_name: code
    storage:
      bucket: mirage-test-chris
      region: ap-southeast-1
      prefix: workspaces/chris/code

  code-ci:
    owner: chris
    label: "Code (AgentCore CI)"
    runtime: code-interpreter
    mount_name: code
    storage:
      bucket: mirage-test-chris
      region: ap-southeast-1
      prefix: workspaces/chris/code

runtimes:
  docker-local:
    image: mirage-runtime:latest
    aws_env_forwarding: true
    # startup_timeout_seconds: 15.0
    # mount_dir: /workspace   # inside-container mount path

  code-interpreter:
    region: us-east-1
    # Built-in identifier: no mounts / no custom IAM.
    # Use a custom identifier from `aws bedrock-agentcore-control
    # create-code-interpreter` if you need VPC + filesystem mounts.
    code_interpreter_identifier: aws.codeinterpreter.v1
    session_timeout_seconds: 900
    # filesystem_configurations:
    #   - s3FilesConfiguration:
    #       accessPointArn: arn:aws:s3files:us-east-1:ACCOUNT:file-system/FS_ID/access-point/AP_ID
    #       fileSystemArn:  arn:aws:s3files:us-east-1:ACCOUNT:file-system/FS_ID
    #       mountPath: /mnt/s3data
