		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^0.122.0",
		"@modelcontextprotocol/sdk": "^1.30.0",
		"@tiptap/core": "^3.30.5",
		"@tiptap/extension-code-block-lowlight": "^3.30.5",
